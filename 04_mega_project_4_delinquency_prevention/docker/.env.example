# Copy this file to ".env" in this same docker/ folder (docker compose auto-
# loads .env from the compose file's own directory) and set a real value --
# never commit the real .env (it is already covered by the repo's
# .gitignore rules for .env / .env.*, excluding this .example file).
#
# API_KEY is REQUIRED -- every /schema and /score endpoint on every service
# in this Mega Project requires this exact value in the request's
# X-API-Key header. Generate a real random key locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# JWT_SECRET_KEY is REQUIRED for the OAuth2/JWT auth path (2026-09-08
# hardening) -- signs and verifies tokens issued by this Mega Project's own
# POST /token endpoint (see src/serving/auth_common.py). The still-supported
# X-API-Key header path above does not need this. Generate a real random
# secret locally the same way as API_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
