# Copy this file to ".env" in this same docker/ folder (docker compose auto-
# loads .env from the compose file's own directory) and set a real value --
# never commit the real .env (it is already covered by the repo's
# .gitignore rules for .env / .env.*, excluding this .example file).
#
# API_KEY is REQUIRED -- the /schema and /score endpoints on this Mega
# Project's one deployable service require this exact value in the
# request's X-API-Key header. Generate a real random key locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
