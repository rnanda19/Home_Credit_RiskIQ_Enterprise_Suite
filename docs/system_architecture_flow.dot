digraph SystemArchitecture {
    bgcolor="#E5E7EB";
    rankdir=TB;
    splines=ortho;
    nodesep=0.55;
    ranksep=0.9;
    concentrate=false;
    compound=true;
    fontname="Liberation Sans,Arial,sans-serif";
    labelloc="t";
    label=<<FONT FACE="Liberation Sans" POINT-SIZE="40" COLOR="#0B1430"><B>HOME CREDIT RISKIQ ENTERPRISE SUITE</B></FONT><BR/><FONT FACE="Liberation Sans" POINT-SIZE="22" COLOR="#334155">System Architecture — Data to Executive Rollup</FONT><BR/><BR/>>;
    node [fontname="Liberation Sans,Arial,sans-serif", fontsize=16, style="filled,rounded", shape=box, color="#05070C", penwidth=2.8, fontcolor="white", margin="0.14,0.12"];
    edge [color="#12296B", penwidth=2.8, arrowsize=0.9, arrowhead=vee];

    DATA [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="12"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 1 · DATA SOURCE</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>HOME CREDIT DEFAULT RISK</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Kaggle — real data, never redistributed</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">application_train/test · bureau · previous_application</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">installments_payments · POS_CASH_balance</FONT></TD></TR></TABLE>>, fillcolor="#0E7490", width=7.2, penwidth=3];
    HYPER [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="12"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 2 · SHARED LIBRARY</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>src/ HYPER SHARED LIBRARY</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Written once — imported by all 5 Mega Projects</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">features/ (feature engineering)  →  reporting/report_builder (HTML + Word + Excel)</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">utils/performance_setup (WARP resource ceilings)  →  serving/scoring_service_common + rate_limit_common</FONT></TD></TR></TABLE>>, fillcolor="#12296B", width=7.2, penwidth=3];
    MP1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 3 · MEGA PROJECT 1</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>UNDERWRITING &amp; APPROVAL</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5 problems · 6 notebooks</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5/5 recommended for production</FONT></TD></TR></TABLE>>, fillcolor="#1D4ED8"];
    MP2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 3 · MEGA PROJECT 2</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>REGULATORY CAPITAL &amp; STRESS</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5 problems · 6 notebooks</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5/5 recommended for production</FONT></TD></TR></TABLE>>, fillcolor="#6D28D9"];
    MP3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 3 · MEGA PROJECT 3</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>RISK SEGMENTATION</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5 problems · 6 notebooks</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">4/5 — Problem 3 disclosed</FONT></TD></TR></TABLE>>, fillcolor="#0F766E"];
    MP4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 3 · MEGA PROJECT 4</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>DELINQUENCY PREVENTION</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5 problems · 6 notebooks</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5/5 recommended for production</FONT></TD></TR></TABLE>>, fillcolor="#B91C1C"];
    MP5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 3 · MEGA PROJECT 5</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>LIQUIDITY &amp; CASHFLOW</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5 problems · 6 notebooks</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5/5 recommended for production</FONT></TD></TR></TABLE>>, fillcolor="#15803D"];
    CARD [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>GOVERNANCE ARTIFACT</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>MODEL_CARD.md — PER PROBLEM</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">2 independent check families per run</FONT></TD></TR></TABLE>>, fillcolor="#B45309"];
    SVC1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 4 · DEPLOYABLE SERVICES</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>BP1 SERVICES (4)</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">credit-default-prediction :9001</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">loan-application-approval :9002</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">credit-score-estimation :9003</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">repayment-capacity-analysis :9004</FONT></TD></TR></TABLE>>, fillcolor="#1D4ED8"];
    SVC2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 4 · DEPLOYABLE SERVICES</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>BP2 SERVICES (2)</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">capital-requirement :9005</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">macro-stress-testing :9006</FONT></TD></TR></TABLE>>, fillcolor="#6D28D9"];
    SVC3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 4 · DEPLOYABLE SERVICES</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>BP3 SERVICES (4)</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">risk-tier-assignment :9007</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">bureau-segment-assignment :9008</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">repayment-segment-assignment :9009</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">utilization-segment-assignment :9010</FONT></TD></TR></TABLE>>, fillcolor="#0F766E"];
    SVC4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 4 · DEPLOYABLE SERVICES</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>BP4 SERVICES (4)</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">early-delinquency-scoring :9011</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">payment-pattern-assignment :9012</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">revolving-distress-scoring :9013</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">pos-cash-trajectory-scoring :9014</FONT></TD></TR></TABLE>>, fillcolor="#B91C1C"];
    SVC5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 4 · DEPLOYABLE SERVICES</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>BP5 SERVICE (1)</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">prepayment-segment-assignment :9015</FONT></TD></TR></TABLE>>, fillcolor="#15803D"];
    DOCKER [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="12"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 5 · DEPLOYMENT</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>DOCKER COMPOSE — MP1–MP5</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Build + run, non-root containers</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Real /health check per Mega Project</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">nginx TLS termination — real self-signed certificate</FONT></TD></TR></TABLE>>, fillcolor="#115E59", width=7.2, penwidth=3];
    CI1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 6 · CI / CD</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>docker-build-verify.yml</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5-entry matrix</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Real docker build + run</FONT></TD></TR></TABLE>>, fillcolor="#166534"];
    CI2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 6 · CI / CD</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>tls-termination-verify.yml</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">5-entry matrix · all 15 services</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Real nginx + real HTTPS</FONT></TD></TR></TABLE>>, fillcolor="#166534"];
    CI3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 6 · CI / CD</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>e2e-tests.yml</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">All 15 services · pytest</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Live subprocess-launched</FONT></TD></TR></TABLE>>, fillcolor="#166534"];
    CI4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="10"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 6 · CI / CD</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>code-quality.yml</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">black · ruff · mypy</FONT></TD></TR></TABLE>>, fillcolor="#166534"];
    EXEC [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="12"><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="14" COLOR="#E8ECF5"><B>STAGE 7 · EXECUTIVE SUMMARY</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="20"><B>00 — SUITE EXECUTIVE ROLLUP</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">Consolidates all 25 problems' real summaries</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">24/25 recommended for production · $951,500,234 illustrative annual benefit</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Liberation Sans" POINT-SIZE="16">HTML + Word + Excel + live dashboard — verified in CI</FONT></TD></TR></TABLE>>, fillcolor="#4C1D95", width=7.2, penwidth=3];

    // ---------- RANKS ----------
    { rank=same; MP1; MP2; MP3; MP4; MP5; CARD; }
    { rank=same; SVC1; SVC2; SVC3; SVC4; SVC5; }
    { rank=same; CI1; CI2; CI3; CI4; }

    // keep left-to-right order stable
    MP1 -> MP2 -> MP3 -> MP4 -> MP5 -> CARD [style=invis];
    SVC1 -> SVC2 -> SVC3 -> SVC4 -> SVC5 [style=invis];
    CI1 -> CI2 -> CI3 -> CI4 [style=invis];

    // ---------- REAL EDGES ----------
    DATA -> HYPER;
    HYPER -> MP1; HYPER -> MP2; HYPER -> MP3; HYPER -> MP4; HYPER -> MP5;

    MP1 -> SVC1; MP2 -> SVC2; MP3 -> SVC3; MP4 -> SVC4; MP5 -> SVC5;
    MP1 -> CARD [style=dashed, constraint=false];
    MP2 -> CARD [style=dashed, constraint=false];
    MP3 -> CARD [style=dashed, constraint=false];
    MP4 -> CARD [style=dashed, constraint=false];
    MP5 -> CARD [style=dashed, constraint=false];

    SVC1 -> DOCKER; SVC2 -> DOCKER; SVC3 -> DOCKER; SVC4 -> DOCKER; SVC5 -> DOCKER;

    DOCKER -> CI1; DOCKER -> CI2; DOCKER -> CI3; DOCKER -> CI4;

    CI1 -> EXEC; CI2 -> EXEC; CI3 -> EXEC; CI4 -> EXEC;
    CARD -> EXEC [constraint=false];

    LEGEND [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="5" BGCOLOR="#F1F3F6" COLOR="#05070C"><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="18" COLOR="#0B1430"><B>LEGEND</B></FONT></TD></TR><TR><TD BGCOLOR="#0E7490" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Data source (Kaggle)</FONT></TD></TR><TR><TD BGCOLOR="#12296B" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Shared library (src/ HYPER)</FONT></TD></TR><TR><TD BGCOLOR="#1D4ED8" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Mega Project 1 — Underwriting</FONT></TD></TR><TR><TD BGCOLOR="#6D28D9" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Mega Project 2 — Regulatory Capital</FONT></TD></TR><TR><TD BGCOLOR="#0F766E" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Mega Project 3 — Risk Segmentation</FONT></TD></TR><TR><TD BGCOLOR="#B91C1C" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Mega Project 4 — Delinquency Prevention</FONT></TD></TR><TR><TD BGCOLOR="#15803D" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Mega Project 5 — Liquidity &amp; Cashflow</FONT></TD></TR><TR><TD BGCOLOR="#B45309" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Governance artifact (MODEL_CARD.md)</FONT></TD></TR><TR><TD BGCOLOR="#115E59" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Deployment (Docker Compose + nginx TLS)</FONT></TD></TR><TR><TD BGCOLOR="#166534" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">CI/CD verification (GitHub Actions)</FONT></TD></TR><TR><TD BGCOLOR="#4C1D95" WIDTH="30" HEIGHT="20"></TD><TD ALIGN="LEFT"><FONT FACE="Liberation Sans" POINT-SIZE="15" COLOR="#0B1430">Executive rollup</FONT></TD></TR></TABLE>>];
    EXEC -> LEGEND [style=invis, constraint=true];
}